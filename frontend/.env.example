# Frontend environment template.
# Copy to `.env.local` in this folder to use when running locally:
#   cp .env.example .env.local

# InsForge SDK Configuration
# Get these from: npx @insforge/cli secrets get ANON_KEY
# The URL is available in .insforge/project.json (oss_host field)
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Base URL of the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
