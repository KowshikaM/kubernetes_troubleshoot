# =============================================================
# AI Kubernetes Troubleshooting Agent - environment template
# Copy this file to `.env` (root) and fill in real values.
# Docker Compose reads `.env` automatically.
# =============================================================

# ---- Backend (FastAPI) ---------------------------------------
# OpenRouter API key for LLM reasoning (used by the AI layer later).
OPENROUTER_API_KEY=
# Default LLM model to use, e.g. openrouter/auto.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Path to the kubeconfig file used to reach the cluster.
KUBECONFIG_PATH=/root/.kube/config
# kubectl binary or full path to it (default: kubectl).
KUBECTL_BIN=kubectl
# Per-command timeout in seconds for kubectl calls (default: 30).
KUBECTL_TIMEOUT_SECONDS=30

# ---- Frontend (Next.js) --------------------------------------
# Base URL of the FastAPI backend. Baked into the frontend build.
# (Host port 8001 -> backend container 8000; 8000 is used by another local project.)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
